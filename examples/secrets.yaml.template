# ESPHome Secrets Template
# Copy this file to 'secrets.yaml' in your ESPHome config directory
# Update the values with your actual credentials

# WiFi Configuration
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Fallback Access Point (when WiFi fails)
ap_password: "FallbackAPPassword"

# API Encryption Key
# Generate with: esphome run <config>.yaml
# Or manually: openssl rand -base64 32
api_encryption_key: "your-32-character-api-encryption-key-here="

# OTA Update Password
ota_password: "YourOTAPassword"

# Home Assistant Configuration (if needed)
# ha_url: "http://homeassistant.local:8123"
# ha_token: "your-long-lived-access-token"

# MQTT Configuration (if using MQTT instead of API)
# mqtt_broker: "192.168.1.100"
# mqtt_username: "your-mqtt-username"
# mqtt_password: "your-mqtt-password"

# Heater BLE MAC Address
# Find using BLE scanner app on your phone
# Format: XX:XX:XX:XX:XX:XX
# heater_mac: "21:47:08:1A:B1:1E"
